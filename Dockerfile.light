FROM --platform=$BUILDPLATFORM golang:1.23-bookworm AS builder

WORKDIR /src

ARG TARGETOS=linux
ARG TARGETARCH=arm64

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/rappamaster .

FROM debian:bookworm-slim

WORKDIR /app

COPY --from=builder /out/rappamaster /app/rappamaster
COPY config.json /app/config.json

EXPOSE 8081 50051

CMD ["/app/rappamaster"]
